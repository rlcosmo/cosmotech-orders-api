{
  "apiVersion": "autoscaling/v2",
  "kind": "HorizontalPodAutoscaler",
  "metadata": {
    "name": "orders-api",
    "namespace": "orders-api"
  },
  "spec": {
    "scaleTargetRef": {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "name": "orders-api"
    },
    "minReplicas": 2,
    "maxReplicas": 2,
    "metrics": [
      {
        "type": "ContainerResource",
        "containerResource": {
          "name": "cpu",
          "container": "orders-api",
          "target": {
            "type": "Utilization",
            "averageUtilization": 70
          }
        }
      }
    ],
    "behavior": {
      "scaleDown": {
        "stabilizationWindowSeconds": 300,
        "policies": [
          {
            "type": "Pods",
            "value": 1,
            "periodSeconds": 60
          }
        ]
      },
      "scaleUp": {
        "stabilizationWindowSeconds": 0,
        "policies": [
          {
            "type": "Pods",
            "value": 1,
            "periodSeconds": 60
          }
        ]
      }
    }
  }
}
